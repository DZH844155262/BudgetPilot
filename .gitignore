# Python缓存
__pycache__/
*.py[cod]

# 测试和代码检查缓存
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 虚拟环境
.venv/
venv/

# 真实环境配置不上传
.env
.env.*

# 示例配置允许上传
!.env.example

# 编辑器配置
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 日志
logs/
*.log

# Next.js / Node
frontend/node_modules/
frontend/.next/
frontend/out/

# 构建产物
dist/
build/
*.egg-info/

# 其他 Python 工具缓存
.mypy_cache/